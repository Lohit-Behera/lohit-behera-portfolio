---
import '../styles/global.css';
import { person, SITE_URL } from '../data/site';
import grotUrl from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import specUrl from '@fontsource/martian-mono/files/martian-mono-latin-400-normal.woff2?url';
interface Props { title: string; description: string; noindex?: boolean; path?: string; bodyClass?: string; preloadFonts?: boolean; themeColor?: string }
const { title, description, noindex = false, path = '/', bodyClass = 'bg-white text-slate-800 antialiased font-sans', preloadFonts = false, themeColor = '#0b1220' } = Astro.props;
// Base-aware URLs: BASE_URL is '/lohit-behera-portfolio' (or with a trailing slash); normalise it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}/${p.replace(/^\//, '')}`;
const canonical = new URL(withBase(path), Astro.site).href;
const ogImage = new URL(withBase('og.png'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: person.name,
      alternateName: person.shortName,
      jobTitle: person.title,
      description: person.tagline,
      email: `mailto:${person.email}`,
      url: `${SITE_URL}/`,
      image: ogImage,
      address: { '@type': 'PostalAddress', addressLocality: 'Bhubaneswar', addressRegion: 'Odisha', addressCountry: 'IN' },
      sameAs: [person.github, person.linkedin],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Jain University' },
        { '@type': 'CollegeOrUniversity', name: 'Utkal University' },
      ],
      knowsAbout: ['Full stack development', 'Large language models', 'Retrieval-augmented generation', 'Model Context Protocol', 'React', 'Next.js', 'Node.js', 'Python', 'Go', 'Tauri', 'iOS and Android apps'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#service`,
      name: `${person.name} – Freelance Full Stack & AI Engineer`,
      url: `${SITE_URL}/`,
      image: ogImage,
      email: person.email,
      founder: { '@id': `${SITE_URL}/#person` },
      areaServed: 'Worldwide',
      address: { '@type': 'PostalAddress', addressLocality: 'Bhubaneswar', addressRegion: 'Odisha', addressCountry: 'IN' },
      serviceType: ['AI chatbots and RAG pipelines', 'Full-stack web applications', 'Native iOS and Android apps', 'Desktop apps with Tauri'],
      priceRange: '$149+',
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <meta name="theme-color" content={themeColor} />
    {preloadFonts && <link rel="preload" href={grotUrl} as="font" type="font/woff2" crossorigin />}
    {preloadFonts && <link rel="preload" href={specUrl} as="font" type="font/woff2" crossorigin />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.title}`} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
